<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData"><RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" /><FocusOnNavigate RouteData="routeData" Selector="h1" /></Found>
    <NotFound><LayoutView Layout="typeof(MainLayout)"><h1>Page not found</h1><a href="/">Return home</a></LayoutView></NotFound>
</Router>
