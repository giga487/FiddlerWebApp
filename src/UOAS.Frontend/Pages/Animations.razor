@page "/animations"
@implements IDisposable
@inject AnimationViewModel ViewModel
<PageTitle>Animations · @ApplicationInfo.Name</PageTitle>
<section class="tool-page"><div class="eyebrow">@ApplicationInfo.ShortName / MOTION</div><h1>Animation browser</h1>
<div class="tool-fields"><CommandButton Command="ViewModel.ArchivesCommand">Find archives</CommandButton><label>Archive<select @bind="ViewModel.File" @bind:after="ViewModel.SearchCommand.ExecuteAsync">@foreach (var archive in ViewModel.Archives) { <option value="@archive.File">@archive.Name · @archive.Bodies bodies</option> }</select></label><label>Category<select @bind="ViewModel.Category"><option value="">All categories</option><option>Monster</option><option>Animal</option><option>Human</option></select></label><label>Body ID<input type="number" min="0" @bind="ViewModel.FindId" /></label><CommandButton Command="ViewModel.SearchCommand">Search</CommandButton></div>
@if (ViewModel.Error is not null) { <p class="notice error">@ViewModel.Error</p> }
<div class="tool-columns"><div><p>@ViewModel.Total bodies</p><div class="asset-grid">@foreach (var body in ViewModel.Bodies) { <button @onclick="() => ViewModel.SelectAsync(body.Id)"><strong>@body.Id</strong><span>@body.Category</span></button> }</div><div class="toolbar"><CommandButton Command="ViewModel.PreviousCommand">Previous</CommandButton><span>@(ViewModel.Page + 1) / @ViewModel.PageCount</span><CommandButton Command="ViewModel.NextCommand">Next</CommandButton></div></div><div>
@if (ViewModel.Actions.Count > 0) { <h2>Body @ViewModel.Body</h2><div class="tool-fields"><label>Action<select @bind="ViewModel.Action" @bind:after="ViewModel.ActionChangedAsync">@foreach (var action in ViewModel.Actions) { <option value="@action.Id">@action.Id · @action.Name</option> }</select></label><label>Direction<select @bind="ViewModel.Direction" @bind:after="ViewModel.DirectionChangedAsync">@foreach (int direction in ViewModel.Directions) { <option value="@direction">@direction</option> }</select></label><CommandButton Command="ViewModel.LoadCommand">Reload sequence</CommandButton></div> }
@if (ViewModel.Atlas is { } atlas) { <AnimationPreview Atlas="atlas" Png="ViewModel.Png" /> }
</div></div><p class="muted">Only the selected sequence is sent to your browser. Playback uses the local Skia canvas.</p></section>
@code { protected override void OnInitialized() => ViewModel.PropertyChanged += Updated; private void Updated(object? sender, PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged); public void Dispose() => ViewModel.PropertyChanged -= Updated; }
