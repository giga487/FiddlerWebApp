@page "/"

<PageTitle>@ApplicationInfo.Name · Home</PageTitle>
<div class="home-page">
    <section class="ultima-terminal @(motionPaused ? "motion-paused" : "")" aria-labelledby="home-heading">
        <div class="terminal-topline"><span>@ApplicationInfo.ShortName / BRITANNIA ASSET TERMINAL</span><span class="terminal-indicator">WORKSHOP ONLINE</span></div>
        <div class="ascii-scene">
            <div class="stars" aria-hidden="true"><span>+</span><span>.</span><span>*</span><span>+</span><span>.</span><span>*</span></div>
            <pre class="ultima-ascii" role="img" aria-label="Ultima Online">@UltimaLogo</pre>
            <div class="ascii-sea" aria-hidden="true"><pre class="ascii-ship">@Ship</pre><div class="sea-line">~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~</div></div>
        </div>
        <div class="hero-copy">
            <div><p class="hero-eyebrow">BUILD SOMETHING WORTH EXPLORING</p><h1 id="home-heading">@ApplicationInfo.Name</h1><p>@ApplicationInfo.Description. Browse, edit and compose the resources behind your world.</p></div>
            <div class="hero-actions"><a class="primary-link" href="/gump">Open the asset catalog <span aria-hidden="true">↗</span></a><a class="secondary-link" href="/configuration">Configure your client folder</a></div>
        </div>
        <button class="motion-toggle" @onclick="() => motionPaused = !motionPaused" aria-pressed="@motionPaused">@(motionPaused ? "Resume animation" : "Pause animation")</button>
    </section>

    <section class="feature-section" aria-labelledby="features-heading">
        <div class="feature-heading"><div><p class="section-label">ONE WORKSPACE, EVERY DETAIL</p><h2 id="features-heading">Explore the workshop</h2></div><p>From an empty asset slot to a finished world.<br />Choose a tool to get started.</p></div>
        <div class="feature-grid">
            @foreach (var feature in Features)
            {
                <a class="feature-card" href="@feature.Path">
                    <div class="feature-card-top"><span class="feature-code">@feature.Code</span><span class="feature-arrow" aria-hidden="true">↗</span></div>
                    <h3>@feature.Title</h3><p>@feature.Description</p><span class="feature-meta">@feature.Formats</span>
                </a>
            }
        </div>
        <div class="workspace-note"><span class="note-symbol" aria-hidden="true">[+]</span><p><strong>Your originals stay yours.</strong> Work with drafts and export new versions. Configure a folder on the server to start browsing your client resources.</p><a href="/configuration">Set up your workspace →</a></div>
    </section>
    <footer class="home-footer"><span>@ApplicationInfo.ShortName · @ApplicationInfo.Name</span><span>MADE FOR WORLDBUILDERS</span></footer>
</div>

@code {
    private bool motionPaused;
    private sealed record Feature(string Code, string Title, string Description, string Formats, string Path);
    private static readonly Feature[] Features =
    [
        new("01 / LIBRARY", "Gump & art catalog", "Browse land tiles, items and Gumps, including empty slots. Find an ID and inspect its pixels and metadata.", "MUL · IDX · UOP", "/gump"),
        new("02 / GRAPHICS", "Import & publish", "Import PNGs into Gump slots and publish a new MUL / IDX version from your locked, private drafts.", "GUMP · PNG · SHARED VERSIONS", "/gump/manage"),
        new("03 / EDITOR", "Item & land editor", "Import and export graphics, edit item and land resources and keep changes in a draft before exporting.", "ART · LAND · PNG", "/art/manage"),
        new("04 / CANVAS", "Gump composition", "Arrange Gump pieces on a grid, adjust their positions and preview the assembled interface.", "LAYERS · GRID · COMPOSITION", "/gump/composition"),
        new("05 / TERRAIN", "Land tiles", "Browse and replace individual terrain tile graphics, including empty IDs and per-resource locks.", "ART · LAND TILES · PNG", "/tiles"),
        new("06 / STRUCTURES", "Multis", "Inspect multi-part structures and their components in an isometric preview.", "MULTI · COMPONENTS · SCENES", "/multi"),
        new("07 / MOTION", "Animations", "Browse animation archives, inspect actions and directions and play frame sequences.", "ANIM · ACTIONS · FRAMES", "/animations"),
        new("08 / PALETTE", "Hue palettes", "Edit 32 RGB555 samples, generate gradients and compare colored asset samples on a local Skia board.", "HUES · SAMPLE BOARD · RGB555", "/colors"),
        new("09 / TYPE", "Fonts", "Browse font glyphs, preview their appearance and import or export glyph images.", "FONTS · GLYPHS · PNG", "/fonts"),
        new("10 / LANGUAGE", "Localization", "Search and edit localized strings by ID, then export a new Cliloc file.", "CLILOC · STRINGS · LOCALIZATION", "/cliloc"),
        new("11 / METADATA", "TileData", "Inspect and edit tile names, flags and properties alongside the graphics they describe.", "TILEDATA · FLAGS · PROPERTIES", "/tiledata"),
        new("12 / TEAM", "Users & collaboration", "See which designer holds each resource lock. Publish changes to different IDs without overwriting another designer's work.", "SESSIONS · ID LOCKS · SHARED VERSIONS", "/users"),
        new("13 / EXTENSIONS", "Server plugins", "Upload DLL or ZIP packages, activate operator-approved hashes and run commands on detached asset images.", "SDK · QUARANTINE · TRUSTED PACKAGES", "/plugins"),
        new("14 / OPERATIONS", "Diagnostics", "Follow live logs, filter messages and exceptions and adjust capture verbosity. Logs also write to rotating files.", "LIVE LOGS · FILTERS · JSON FILES", "/diagnostics"),
        new("15 / INTEGRATION", "HTTP API", "Explore the OpenAPI contract for session-based asset reading, rendering and collaborative resource editing.", "OPENAPI · HTTP · WORKSPACES", "/api-reference"),
        new("16 / COMPARE", "Compare Gumps", "Compare configured libraries and copy reference graphics into locked destination IDs.", "COMPARISON · COPY · PRIVATE DRAFTS", "/gump/compare"),
        new("17 / SERVER", "Server regions", "Edit server region volumes, hierarchy, rules and visibility with per-ID locks and compatible JSON publishing.", "MODERNUO · REGIONS.JSON · 3D BOUNDS", "/regions")
    ];
