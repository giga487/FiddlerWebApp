@implements IDisposable
@inject ColorBoardViewModel Board
@inject DocumentViewModel Document
<section><h2>Hue sample board</h2><div class="tool-fields"><label>Resource<select @bind="Board.Kind">@foreach (var kind in Enum.GetValues<ResourceKind>()) { <option value="@kind">@kind</option> }</select></label><label>ID<input type="number" min="0" @bind="Board.Id" /></label><CommandButton Command="Board.AddCommand">Add sample</CommandButton><button @onclick="Board.Clear">Clear board</button><label>Mode<select @bind="Board.Mode"><option>Automatic</option><option>Full</option><option>Gray only</option></select></label><label>Background<select @bind="Board.Background"><option>Checkerboard</option><option>Dark</option><option>Light</option></select></label><label>Zoom<select @bind="Board.Zoom"><option>1</option><option>2</option><option>4</option><option>8</option></select></label></div>
@if (Board.Error is not null) { <p class="notice error">@Board.Error</p> }
<p class="muted">Original on the left, current palette on the right. Automatic mode follows the item's TileData PartialHue flag. Up to 8 samples; palette changes render locally.</p>
<div class="sample-grid">@foreach (var sample in Board.Samples) { <article @key="sample"><div class="toolbar"><strong>@sample.Kind @sample.Id</strong><span>@(sample.PartialHue ? "Partial hue" : "Full hue")</span><button @onclick="() => Board.Remove(sample)">Remove</button></div><HueSample Png="sample.Png" Colors="Document.Palette" GrayOnly="@(Board.Mode == "Gray only" || Board.Mode == "Automatic" && sample.PartialHue)" Background="Board.Background" Zoom="Board.Zoom" /></article> }</div></section>
@code { protected override void OnInitialized() { Board.PropertyChanged += Updated; Document.PropertyChanged += Updated; } private void Updated(object? sender, PropertyChangedEventArgs args) => _ = InvokeAsync(StateHasChanged); public void Dispose() { Board.PropertyChanged -= Updated; Document.PropertyChanged -= Updated; } }
