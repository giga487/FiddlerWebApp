{
  "Serilog": { "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning" } } },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Storage": { "RootDirectory": "" },
  "Assets": { "Libraries": { "default": { "Name": "Client assets", "Directory": "" } }, "ExportDirectory": "Exports" },
  "Frontend": { "Origins": ["http://localhost:5178", "http://127.0.0.1:5178"] },
  "Diagnostics": { "BufferCapacity": 2000, "LogDirectory": "App_Data/logs" },
  "Plugins": { "TrustedPackageHashes": [] },
  "Regions": { "Sources": { "default": { "Name": "Server regions", "File": "", "Directory": "", "Maps": [], "Types": [] } } }
}
