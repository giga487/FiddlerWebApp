{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  },
  "Diagnostics": {
    "AdministratorIds": [],
    "BufferCapacity": 2000,
    "LogDirectory": "App_Data/logs"
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Authentication": {
    "Mode": "Required"
  },
  "Plugins": {
    "AdministratorIds": []
  },
  "Mul": {
    "Directory": ""
  }
}
