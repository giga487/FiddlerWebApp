@inherits LayoutComponentBase
@inject IThemeService Theme

<header class="app-header">
    <a class="brand" href="/" aria-label="Fiddler Web App"><span class="brand-mark">F</span> Fiddler <span class="brand-web">WEB APP</span></a>
    <span class="project-label">SEAHATS / ASSET STUDIO</span>
    <span class="read-only">Sola lettura</span>
</header>
<main>@Body</main>
<FluentProviders />
<div id="blazor-error-ui" data-nosnippet>La sessione ha incontrato un errore. <a href="/">Riapri l'applicazione</a></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.SetThemeAsync(ThemeMode.Light);
            await Theme.SetThemeAsync("#087f79", true);
        }
    }
}
