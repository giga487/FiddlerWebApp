@inherits LayoutComponentBase
@inject IThemeService Theme

<header class="app-header">
    <a class="brand" href="/" aria-label="Fiddler Web App"><span class="brand-mark">F</span> Fiddler <span class="brand-web">WEB APP</span></a>
    <span class="project-label">SEAHATS / ASSET STUDIO</span>
    <nav class="header-nav" aria-label="Navigazione principale"><NavLink href="/gump">Gump</NavLink><NavLink href="/animazioni">Animazioni</NavLink><NavLink href="/configurazione">Configurazione</NavLink></nav>
    <span class="read-only">Workspace</span>
</header>
<main>@Body</main>
<FluentProviders />
<div id="blazor-error-ui" data-nosnippet>La sessione ha incontrato un errore. <a href="/">Riapri l'applicazione</a></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.SetThemeAsync(new ThemeSettings("#087f79", 0, 0, ThemeMode.Light, true));
        }
    }
}
