@inherits LayoutComponentBase
@inject IThemeService Theme

<header class="app-header">
    <a class="brand" href="/" aria-label="Fiddler Web App"><span class="brand-mark">F</span> Fiddler <span class="brand-web">WEB APP</span></a>
    <span class="project-label">ULTIMA ONLINE / ASSET STUDIO</span>
    <nav class="header-nav" aria-label="Main navigation"><NavLink href="/gump">Gump / Art</NavLink><NavLink href="/multi">Multi</NavLink><NavLink href="/maps">Maps</NavLink><NavLink href="/animations">Animations</NavLink><NavLink href="/configuration">Configuration</NavLink></nav>
    <NavLink class="read-only" href="/colors">Color studio</NavLink>
</header>
<main>@Body</main>
<FluentProviders />
<div id="blazor-error-ui" data-nosnippet>The session encountered an error. <a href="/">Reopen the application</a></div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Theme.SetThemeAsync(new ThemeSettings("#087f79", 0, 0, ThemeMode.Light, true));
        }
    }
}
