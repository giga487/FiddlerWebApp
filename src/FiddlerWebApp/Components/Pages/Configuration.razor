@page "/configuration"
@page "/configurazione"
@using Fiddler.Formats.Catalog
@implements IDisposable
@inject ClientDirectoryScanner Scanner
@inject ClientDirectorySettings Settings
@inject MulWorkspace Workspace
@inject AnimationWorkspace Animations

<PageTitle>Folder configuration · @ApplicationInfo.Name</PageTitle>
<section class="configuration">
    <div class="section-label">WORKSPACE / CONFIGURATION</div>
    <h1>Client data folder</h1>
    <p class="configuration-intro">Enter a folder on the operating system running @ApplicationInfo.Name. The scan checks files in that folder without changing them.</p>
    <div class="configuration-panel">
        <form @onsubmit="Analyze" @onsubmit:preventDefault>
            <label for="client-directory">Absolute path on the server</label>
            <div class="directory-input-row"><input id="client-directory" @bind="directory" @bind:event="oninput" @bind:after="Invalidate"
                placeholder="D:\Data\Client or /srv/uo/client" disabled="@busy" spellcheck="false" autocomplete="off" />
                <button class="search-submit" type="submit" disabled="@busy">@(busy ? "Scanning…" : "Scan folder")</button></div>
        </form>
        <p class="muted">Saved folder: <strong class="saved-directory">@(string.IsNullOrEmpty(Settings.Directory) ? "None" : Settings.Directory)</strong></p>
        @if (error is not null) { <div class="notice error" role="alert">@error</div> }
        @if (saved) { <div class="notice success" role="status">Folder saved. <a href="/">Go to archive</a> and click Open archive to load the files.</div> }
    </div>
    @if (report is not null)
    {
        <div class="scan-summary" aria-live="polite">
            <div><strong>@report.Files.Count(file => file.Status == ClientFileStatus.Present)</strong><span>Present</span></div>
            <div><strong>@report.Files.Count(file => file.Status == ClientFileStatus.Missing)</strong><span>Missing</span></div>
            <div><strong>@report.Files.Count(file => file.Status == ClientFileStatus.Alternative)</strong><span>Covered by alternatives</span></div>
            <div><strong>@report.Files.Count(file => IsProblem(file.Status))</strong><span>Needs review</span></div>
            <div><strong>@ClientFileCatalog.ExpectedFiles.Count</strong><span>Known files</span></div>
        </div>
        <div class="scan-actions"><div><strong>@(report.CanView ? "Archives available for the viewer" : "No complete archive available for the viewer")</strong>
            <p class="muted">@(report.CanView ? "Archives are available for graphics, animations, Multis or maps. Multi and map previews also require Art images." : "Complete, readable archives are required for a supported collection.")</p></div>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Save" Disabled="@(busy || saved)">Save folder</FluentButton></div>
        <p class="inventory-explanation">Required files depend on the client version, maps and features in use. Alternative formats may provide the same resource; current viewer support is explained below.</p>
        <p class="muted">Checks file presence, size, readability and index alignment. Does not fully validate archive contents.</p>
        var missingFiles = report.Files.Where(file => file.Status is ClientFileStatus.Missing or ClientFileStatus.Alternative || IsProblem(file.Status))
            .OrderBy(file => file.Guidance!.Importance).ThenBy(file => file.Name, StringComparer.OrdinalIgnoreCase).ToArray();
        <section class="missing-file-explanations" aria-labelledby="missing-files-heading">
            <h2 id="missing-files-heading">Missing files: what they affect</h2>
            <p>Required means required for a specific viewer feature, not for the entire application. Maps and numbered animation archives are independent. This scan does not certify that a game installation is complete.</p>
            @if (missingFiles.Length == 0)
            { <p class="viewer-note">All catalog files are present and passed the basic checks.</p> }
            else
            {
                <div class="file-table-container"><table class="file-table missing-file-table">
                    <caption class="muted">Missing, unusable and alternative-covered files, with their purpose and impact.</caption>
                    <thead><tr><th scope="col">File</th><th scope="col">Importance</th><th scope="col">Purpose and impact</th></tr></thead>
                    <tbody>@foreach (var file in missingFiles)
                    {
                        var help = file.Guidance!;
                        <tr><td><code>@file.Name</code><div class="file-explanation-status">@(file.Status == ClientFileStatus.Alternative && help.Importance == ClientFileImportance.RequiredForFeature ? "Alternative has limited support" : FileLabel(file.Status))</div></td>
                            <td><span class="file-status @(help.Importance == ClientFileImportance.RequiredForFeature ? "status-warning" : help.Importance == ClientFileImportance.CoveredByAlternative ? "status-ok" : "status-muted")">@ImportanceLabel(help.Importance)</span><div class="file-explanation-status">@help.Feature</div></td>
                            <td><p>@help.Purpose</p><p class="file-impact">@help.Impact</p>@if (file.Detail is not null) { <p class="muted">@file.Detail</p> }</td></tr>
                    }</tbody>
                </table></div>
            }
        </section>
        <div class="inventory-toolbar"><h2>File scan</h2><label><input type="checkbox" @bind="onlyIssues" /> Show only missing files and issues</label></div>
        @foreach (var group in report.Groups)
        {
            var visibleFiles = group.Files.Where(file => !onlyIssues || file.Status is not (ClientFileStatus.Present or ClientFileStatus.Alternative)).ToArray();
            if (visibleFiles.Length == 0) { continue; }
            <details class="file-group" open="@(group.Status is ClientGroupStatus.Incomplete or ClientGroupStatus.Invalid)">
                <summary><span><span class="group-category">@group.Definition.Category</span><strong>@group.Definition.Name</strong></span><span class="file-status @GroupClass(group.Status)">@GroupLabel(group.Status)</span></summary>
                <div class="group-content">
                    <p class="muted alternatives">@string.Join(" or ", group.Definition.Alternatives.Select(alternative => string.Join(" + ", alternative)))</p>
                    @if (group.Definition.ViewerSupported && group.Status == ClientGroupStatus.Available)
                    { <p class="viewer-note">@(group.CanView ? "Viewer available." : "UOP format recognized. This collection still requires MUL files in the web viewer.")</p> }
                    <div class="file-table-container"><table class="file-table"><thead><tr><th>File</th><th>Status</th><th>Size</th><th>Details</th></tr></thead><tbody>
                        @foreach (var file in visibleFiles)
                        {
                            <tr><td><code>@file.Name</code></td><td><span class="file-status @FileClass(file.Status)">@FileLabel(file.Status)</span></td>
                                <td>@(file.Size is long length ? $"{length:N0} byte" : "—")</td><td><p>@file.Guidance?.Purpose</p><p>@file.Guidance?.Impact</p>@file.Detail</td></tr>
                        }
                    </tbody></table></div>
                </div>
            </details>
        }
        @if (report.OtherFiles.Count > 0)
        {
            <details class="file-group"><summary><strong>Other files in the folder</strong><span>@report.OtherFiles.Count</span></summary>
                <div class="group-content"><p class="muted">Files outside the standard client file catalog. They may be custom resources.</p>
                    <ul class="other-files">@foreach (var file in report.OtherFiles.Take(100)) { <li><code>@file</code></li> }</ul>
                    @if (report.OtherFiles.Count > 100) { <p class="muted">Showing the first 100 names.</p> }</div></details>
        }
    }
</section>

@code {
    private string directory = "";
    private string? error;
    private bool busy, saved, onlyIssues;
    private ClientDirectoryReport? report;
    private readonly CancellationTokenSource lifetime = new();
    protected override void OnInitialized() => directory = Settings.Directory;
    private void Invalidate() { report = null; saved = false; error = null; }

    private async Task Analyze()
    {
        if (busy) return;
        busy = true; saved = false; error = null; report = null;
        string selectedDirectory = directory;
        var token = lifetime.Token;
        try
        {
            report = await Task.Run(() => Scanner.Scan(selectedDirectory, token), token);
            directory = report.Directory;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException) { error = ex.Message; }
        finally { busy = false; }
    }
    private void Save()
    {
        if (report is null || busy) return;
        if (Workspace.Gumps?.HasChanges == true) { error = "Save or discard Gump drafts before changing the folder."; return; }
        try
        {
            Settings.Save(report.Directory);
            Workspace.Dispose();
            Animations.Dispose();
            saved = true; error = null;
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException) { error = "Cannot save folder: " + ex.Message; }
    }
    private static bool IsProblem(ClientFileStatus status) => status is ClientFileStatus.Invalid or ClientFileStatus.Empty or ClientFileStatus.Unreadable or ClientFileStatus.Ambiguous;
    private static string ImportanceLabel(ClientFileImportance importance) => importance switch
    { ClientFileImportance.RequiredForFeature => "Required for this feature", ClientFileImportance.Optional => "Optional enhancement", ClientFileImportance.CoveredByAlternative => "Covered by alternative", _ => "Not used by this viewer" };
    private static string FileClass(ClientFileStatus status) => status == ClientFileStatus.Present ? "status-ok" : IsProblem(status) ? "status-error" : "status-muted";
    private static string GroupClass(ClientGroupStatus status) => status switch { ClientGroupStatus.Available => "status-ok", ClientGroupStatus.Incomplete => "status-warning", ClientGroupStatus.Invalid => "status-error", _ => "status-muted" };
    private static string GroupLabel(ClientGroupStatus status) => status switch { ClientGroupStatus.Available => "Available", ClientGroupStatus.Incomplete => "Incomplete", ClientGroupStatus.Invalid => "Needs review", _ => "Missing" };
    private static string FileLabel(ClientFileStatus status) => status switch { ClientFileStatus.Present => "Present", ClientFileStatus.Missing => "Missing", ClientFileStatus.Alternative => "Covered alternative", ClientFileStatus.Empty => "Empty", ClientFileStatus.Unreadable => "Unreadable", ClientFileStatus.Ambiguous => "Ambiguous name", _ => "Invalid index" };
    public void Dispose() { lifetime.Cancel(); lifetime.Dispose(); }
}
