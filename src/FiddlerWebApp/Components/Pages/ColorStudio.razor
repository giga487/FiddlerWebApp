@page "/colors"
@using Fiddler.Formats.Hues
@inject ColorStudioWorkspace Studio
@inject MulWorkspace AssetsWorkspace
@inject ClientDirectorySettings Settings
@inject SkiaAssetRenderer Renderer
@inject ClientResourceWorkspace Resources

<PageTitle>Color studio · @ApplicationInfo.Name</PageTitle>
<div class="color-studio">
    <div class="color-heading"><div><div class="section-label">@ApplicationInfo.ShortName / COLORS</div><h1>Color studio</h1>
        <p>Build a hue and see how it behaves on your own collection of objects.</p></div>
        <a href="/configuration">Configure client folder</a></div>
    @if (error is not null) { <div class="notice error" role="alert">@error</div> }
    @if (exportPath is not null) { <div class="notice color-success" role="status">Exported complete library: <strong>@exportPath</strong><br />Original files are unchanged. Your drafts remain available.</div> }
    <div class="color-layout">
        <aside class="color-library color-panel" aria-label="Hue library">
            <h2>Hue library</h2>
            <button class="color-primary" @onclick="() => Open(false)">Open configured library</button>
            @if (Studio.Document?.HasChanges == true)
            {
                <button @onclick="() => discardRequested = !discardRequested">Discard and reopen…</button>
                @if (discardRequested)
                {
                    <div class="notice error">This removes all hue drafts and board samples.
                        <button @onclick="() => Open(true)">Discard drafts and reopen</button>
                        <button @onclick="() => discardRequested = false">Keep working</button>
                    </div>
                }
            }
            @if (Studio.Document is { } library)
            {
                <p class="muted">@Studio.DirectoryPath</p>
                @if (library.SourceCount == 0) { <p class="muted">New library: the export will contain only hues created here.</p> }
                <button @onclick="NewHue">Create a new hue</button>
                <label>Find game ID or name<input placeholder="123, 0x007B or name" @bind="search" @bind:event="oninput" @bind:after="ResetLibraryPage" /></label>
                <p class="muted">@MatchingIds.Count hues · * = draft</p>
                <div class="color-hue-list">
                    @foreach (int id in MatchingIds.Skip(libraryPage * LibraryPageSize).Take(LibraryPageSize))
                    {
                        var entry = library.Read(id);
                        <button class="color-hue @(Studio.SelectedId == id ? "active" : "")" @onclick="() => SelectHue(id)" aria-pressed="@(Studio.SelectedId == id)">
                            <span class="color-mini-ramp" style="background:@Ramp(entry.Colors.ToArray())"></span>
                            <span><strong>@id · @($"0x{id:X4}") @(library.IsModified(id) ? "*" : "")</strong><span>@(string.IsNullOrWhiteSpace(entry.Name) ? "Unnamed hue" : entry.Name)</span></span>
                        </button>
                    }
                </div>
                <div class="color-pagination"><button disabled="@(libraryPage == 0)" @onclick="PreviousHues">Previous</button>
                    <span>@(libraryPage + 1) / @LibraryPageCount</span><button disabled="@(libraryPage + 1 >= LibraryPageCount)" @onclick="NextHues">Next</button></div>
            }
            else { <p class="muted">Open the client folder to load hues.mul. A missing hues.mul starts an empty library.</p> }
        </aside>
        <section class="color-workbench" aria-label="Hue editor and sample board">
            @if (Current is { } current)
            {
                <section class="color-panel color-editor">
                    <div class="color-editor-heading"><div><div class="section-label">EDITING GAME HUE</div><h2>@current.Id · @($"0x{current.Id:X4}")</h2></div>
                        <div class="color-actions"><button @onclick="DuplicateHue">Duplicate as new hue</button>
                            <button disabled="@(!Studio.Document!.CanUndo(current.Id))" @onclick="Undo">Undo</button>
                            <button disabled="@(current.Id > Studio.Document!.SourceCount || !Studio.Document.IsModified(current.Id))" @onclick="Restore">Restore original</button></div></div>
                    <label>Hue name <span class="muted">20 ASCII characters maximum</span><input value="@hueName" @onchange="Rename" maxlength="20" /></label>
                    <p class="muted">32 shades form this hue. Select a shade to edit it; every object below uses this same palette. Different objects can bring out different shades.</p>
                    <div class="color-palette" aria-label="32 palette samples">
                        @for (int index = 0; index < 32; index++)
                        {
                            int slot = index;
                            <button class="@(selectedSlot == slot ? "active" : "")" style="background:@Hex(colors[slot])" @onclick="() => SelectSlot(slot)"
                                title="@($"Sample {slot}: {Hex(colors[slot])}")" aria-label="@($"Edit palette sample {slot}: {Hex(colors[slot])}")" aria-pressed="@(selectedSlot == slot)"><span>@slot</span></button>
                        }
                    </div>
                    <div class="color-slot-editor"><label>Sample @selectedSlot<input type="color" value="@slotColor" @oninput="ChangeSlot" /></label>
                        <span>@Hex(colors[selectedSlot]) · RGB555 @($"0x{colors[selectedSlot]:X4}")</span>
                        <span class="muted">The preview shows the actual 15-bit game color.</span></div>
                    <details class="color-generator"><summary>Generate a palette from shadows, midtones and highlights</summary>
                        <div class="color-actions"><label>Shadows<input type="color" @bind="shadow" /></label><label>Midtones<input type="color" @bind="middle" /></label>
                            <label>Highlights<input type="color" @bind="highlight" /></label><button @onclick="Generate">Generate 32 samples</button></div>
                        <p class="muted">Replaces this draft palette. Undo restores the previous colors.</p>
                    </details>
                </section>
            }
            else
            {
                <div class="color-panel color-empty"><h2>A color is best judged on objects</h2><p>Open your hue library, then choose an existing hue or create a new one. Add different objects to the board to compare their response.</p></div>
            }
            <section class="color-panel">
                <div class="color-board-heading"><div><h2>Your sample board</h2><p class="muted">Each card compares the original with the current hue. Samples and drafts survive navigation within this session.</p></div>
                    <label>Background<select @bind="background"><option value="checker">Checkerboard</option><option value="light">Light</option><option value="dark">Dark</option></select></label>
                    <label>Zoom<select @bind="zoom"><option value="1">100%</option><option value="2">200%</option></select></label></div>
                <form class="color-add" @onsubmit="AddSample" @onsubmit:preventDefault>
                    <label>Asset type<select @bind="sampleKind" @bind:after="ResetCatalog"><option value="@AssetKind.Item">Item</option><option value="@AssetKind.Gump">Gump</option></select></label>
                    <label>Asset ID<input @bind="sampleId" placeholder="Decimal or 0x…" /></label>
                    <label>Color mode<select @bind="sampleMode"><option value="Auto">Automatic (TileData)</option><option value="@nameof(HueMode.Full)">Full color</option><option value="@nameof(HueMode.GrayPixelsOnly)">Gray pixels only</option></select></label>
                    <button type="submit" disabled="@(Studio.Document is null)">Add sample</button>
                    <button type="button" disabled="@(Studio.Document is null)" @onclick="ToggleCatalog">@(showCatalog ? "Close asset picker" : "Browse assets visually")</button>
                </form>
                @if (showCatalog)
                {
                    <div class="color-asset-picker" aria-label="Choose sample assets">
                        <p class="muted">@sampleKind catalog · click an image to add it using the selected color mode.</p>
                        <div class="color-picker-grid" style="--catalog-zoom:@catalogZoom">
                            @foreach (var tile in catalogTiles)
                            {
                                <button @onclick="() => AddCatalogSample(tile.Id)" aria-label="@($"Add {sampleKind} {tile.Id} to sample board")">
                                    <span class="checker"><img src="@tile.Image" alt="" /></span><strong>@tile.Id · @($"0x{tile.Id:X4}")</strong>
                                </button>
                            }
                        </div>
                        @if (catalogTiles.Count == 0) { <p>No readable assets on this page. Try another page or collection.</p> }
                        <div class="color-pagination color-catalog-pagination">
                            <label class="color-page-size">Show
                                <select @bind="catalogPageSize" @bind:after="ChangeCatalogPageSize" aria-label="Assets per page">
                                    @foreach (int size in CatalogPageSizes) { <option value="@size">@size</option> }
                                </select> per page</label>
                            <label class="color-page-size">Zoom
                                <select @bind="catalogZoom" aria-label="Asset preview zoom">
                                    <option value="1">100%</option><option value="2">200%</option>
                                    <option value="3">300%</option><option value="4">400%</option>
                                </select></label>
                            <button disabled="@(catalogPage == 0)" @onclick="PreviousAssets">Previous assets</button>
                            <span>@(catalogPage + 1) / @CatalogPageCount</span><button disabled="@(catalogPage + 1 >= CatalogPageCount)" @onclick="NextAssets">Next assets</button></div>
                    </div>
                }
                <p class="muted">Automatic uses the Item's PartialHue flag from TileData, including this session's metadata drafts. Missing TileData and Gumps use full color. Override the mode per sample to compare both results.</p>
                @if (Studio.Samples.Count == 0)
                {
                    <div class="color-empty"><h3>Choose objects that matter to your color</h3><p>Try a garment, a weapon, furniture and a Gump. Add them by ID above or send them here from the Gump / Art catalog.</p></div>
                }
                <div class="color-sample-grid">
                    @foreach (var sample in Studio.Samples)
                    {
                        <article class="color-sample" @key="sample.Key">
                            <div class="color-sample-heading"><strong>@sample.Kind @sample.AssetId · @($"0x{sample.AssetId:X4}")</strong><button @onclick="() => RemoveSample(sample.Key)" aria-label="@($"Remove {sample.Kind} {sample.AssetId} sample")">Remove</button></div>
                            <label>Color mode<select value="@sample.Mode" @onchange="args => ChangeMode(sample, args)"><option value="@HueMode.Full">Full color</option><option value="@HueMode.GrayPixelsOnly">Gray pixels only</option></select></label>
                            <div class="color-comparison color-bg-@background" style="--sample-zoom:@zoom">
                                <figure><figcaption>Original · hue 0</figcaption><div><img src="@Originals.GetValueOrDefault(sample.Key)" alt="@($"Original {sample.Kind} {sample.AssetId}")" /></div></figure>
                                <figure><figcaption>Hue @Studio.SelectedId</figcaption><div><img src="@Previews.GetValueOrDefault(sample.Key)" alt="@($"{sample.Kind} {sample.AssetId} with hue {Studio.SelectedId}, {ModeName(sample.Mode)}")" /></div></figure>
                            </div>
                            <p class="muted">@sample.Image.Width × @sample.Image.Height px · @ModeName(sample.Mode)</p>
                        </article>
                    }
                </div>
            </section>
            @if (Studio.Document is { } document)
            {
                <section class="color-panel color-export"><div><h2>Export hue library</h2><p class="muted">Writes the complete library with your drafts to a new subfolder. New hues keep their displayed game IDs. Blocks are padded to eight entries.</p></div>
                    <label>Output parent folder on the server<input @bind="outputDirectory" placeholder="Absolute folder path" /></label>
                    <button class="color-primary" disabled="@(document.Count == 0)" @onclick="Export">Export new hues.mul</button></section>
            }
        </section>
    </div>
</div>
