@page "/fonts"
@inherits ResourceEditorPage
@using Fiddler.Formats.Fonts
@using Fiddler.Graphics.Gumps

<PageTitle>Fonts · @ApplicationInfo.Name</PageTitle>
<section class="resource-editor">
    <div class="section-label">@ApplicationInfo.ShortName / TYPOGRAPHY</div><h1>Fonts</h1>
    <p>Browse ASCII and Unicode fonts, replace glyph images and adjust Unicode offsets. Exports create new client files.</p>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (exported is not null) { <p class="notice success" role="status">Exported: @exported</p> }
    <div class="resource-toolbar">
        <label>Font file<select @bind="file" disabled="@busy">@foreach (string name in files) { <option>@name</option> }</select></label>
        <button @onclick="Open" disabled="@(busy || files.Length == 0)">Open font</button><a href="/configuration">Configure folder</a>
    </div>
    @if (files.Length == 0) { <p>No fonts.mul or unifont*.mul found in the configured folder.</p> }
    @if (Resources.Font is { } document)
    {
        <p>@Resources.FontDirectory / @document.FileName · @(document.Unicode ? "Unicode / 1-bit glyphs" : "ASCII / RGB555 glyphs") · @document.DirtyCount draft changes</p>
        <div class="resource-toolbar"><label>Font index<select @bind="font" @bind:after="ChangeFont">@foreach (int index in document.Fonts) { <option value="@index">@index</option> }</select></label>
            <label>Find character code<input @bind="codeInput" placeholder="65 or 0x0041" /></label><button @onclick="Find">Show code</button>
            <label>Zoom<select @bind="zoom"><option value="1">100%</option><option value="2">200%</option><option value="4">400%</option></select></label></div>
        <div class="resource-columns">
            <div>
                <div class="resource-grid">
                    @foreach (var glyph in glyphs.Skip(page * 64).Take(64))
                    {
                        <button @onclick="() => Select(glyph.Code)" aria-label="@($"Edit character U+{glyph.Code:X4}")">
                            <span class="checker">@if (glyph.Width > 0 && glyph.Height > 0) { <img src="@Png(document.Image(font, glyph.Code))" alt="" /> }</span>
                            <strong>@($"U+{glyph.Code:X4}")</strong><span>@glyph.Width × @glyph.Height</span></button>
                    }
                </div>
                <div class="resource-toolbar"><button disabled="@(page == 0)" @onclick="() => page--">Previous</button><span>@(page + 1) / @PageCount</span><button disabled="@(page + 1 >= PageCount)" @onclick="() => page++">Next</button></div>
                <label>Test text<textarea rows="3" maxlength="512" @bind="testText"></textarea></label>
                <button @onclick="PreviewText" disabled="@busy">Render text with this font</button>
                @if (textPreview is not null) { <div class="resource-preview checker"><img src="@textPreview" alt="Text rendered from client font glyphs" style="zoom:@zoom" /></div> }
            </div>
            <div class="resource-panel">
                <h2>@($"U+{code:X4}")</h2>
                @if (preview is not null) { <div class="resource-preview checker"><img src="@preview" alt="Selected font glyph" style="zoom:@zoom" /></div><a href="@preview" download="@($"glyph-{font}-{code:X4}.png")">Download glyph PNG</a> }
                <label>Replace / add glyph PNG<InputFile OnChange="Import" accept="image/png" disabled="@busy" /></label>
                <p class="muted">Maximum 255 × 255 pixels and 8 MiB. Unicode stores an ink mask: pixels with alpha ≥ 128 become black ink. Use a transparent background. ASCII stores RGB555 colors with transparent zero.</p>
                @if (document.Unicode)
                { <div class="resource-toolbar"><label>X offset<input type="number" min="-128" max="127" @bind="xOffset" /></label><label>Y offset<input type="number" min="-128" max="127" @bind="yOffset" /></label><button @onclick="Offsets" disabled="@busy">Save offsets in draft</button></div> }
                <div class="resource-toolbar"><button @onclick="Clear" disabled="@busy">Clear glyph</button><button @onclick="Undo" disabled="@busy">Undo glyph</button><button @onclick="Discard" disabled="@busy">Discard all font drafts</button></div>
            </div>
        </div>
        <div class="resource-toolbar"><label>Output parent folder on server<input @bind="output" placeholder="Absolute path" /></label><button @onclick="Export" disabled="@busy">Export new font file</button></div>
    }
</section>
@code {
    private string[] files = [];
    private string file = "", codeInput = "65", testText = "Ultima Online";
    private int font, code = 65, page, zoom = 2;
    private sbyte xOffset, yOffset;
    private string? preview, textPreview;
    private FontGlyph[] glyphs = [];
    private int PageCount => Math.Max(1, (glyphs.Length + 63) / 64);
    protected override void OnInitialized()
    {
        files = ClientResourceWorkspace.Files(Settings.Directory, "*font*.mul").Where(name => name.Equals("fonts.mul", StringComparison.OrdinalIgnoreCase) || name.StartsWith("unifont", StringComparison.OrdinalIgnoreCase)).ToArray();
        file = files.FirstOrDefault() ?? "";
        if (Resources.Font is not null) { font = Resources.Font.Fonts.FirstOrDefault(); Refresh(); }
    }
    private Task Open() => Run(() => { Resources.OpenFont(Settings.Directory, file); font = Resources.Font!.Fonts.FirstOrDefault(); code = 65; Refresh(); });
    private Task ChangeFont() => Run(() => { page = 0; Refresh(); });
    private Task Select(int next) => Run(() => { code = next; codeInput = next.ToString(); LoadGlyph(); });
    private Task Find() => Run(() => { code = Id(codeInput); LoadGlyph(); });
    private void Refresh() { glyphs = Resources.Font!.Glyphs(font).ToArray(); page = Math.Min(page, PageCount - 1); textPreview = null; LoadGlyph(); }
    private void LoadGlyph()
    {
        var glyph = Resources.Font!.Read(font, code); xOffset = glyph.XOffset; yOffset = glyph.YOffset;
        preview = Png(Resources.Font.Image(font, code)); codeInput = code.ToString();
    }
    private Task Import(InputFileChangeEventArgs args) => RunAsync(async () =>
    { var image = GumpImageImporter.ImportImage(await Upload(args.File)); Resources.Font!.Put(font, code, image, xOffset, yOffset); Refresh(); });
    private Task Offsets() => Run(() => { Resources.Font!.SetOffsets(font, code, xOffset, yOffset); Refresh(); });
    private Task Clear() => Run(() => { Resources.Font!.Clear(font, code); Refresh(); });
    private Task Undo() => Run(() => { Resources.Font!.Undo(font, code); Refresh(); });
    private Task Discard() => Run(() => { Resources.Font!.Discard(); Refresh(); });
    private Task PreviewText() => Run(() => textPreview = Png(Resources.Font!.RenderText(font, testText)));
    private Task Export() => RunAsync(async () => exported = await Task.Run(() => Resources.Font!.Export(output)));
}
