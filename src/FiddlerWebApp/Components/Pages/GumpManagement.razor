@page "/gump/manage"
@page "/gump/gestione"
@inject MulWorkspace Workspace
@inject ClientDirectorySettings Settings
@inject SkiaAssetRenderer Renderer
@using FiddlerWebApp.Services.Users
@inject UserSession Session

<PageTitle>Gump import and comparison · @ApplicationInfo.Name</PageTitle>
<section class="gump-management">
    <div class="section-label">GUMP / IMPORT AND COMPARE</div>
    <div class="gump-management-heading"><div><h1>Gump management</h1><p class="muted">Import images or copy Gumps from another archive.</p></div><a href="/gump">Back to viewer</a></div>
    @if (Error is not null) { <div class="notice error" role="alert">@Error</div> }
    @if (Info is not null) { <div class="notice success" role="status">@Info</div> }
    @if (Busy) { <div class="notice" role="status">@OperationLabel @(OperationLabel == "Comparing" ? $"{Progress}%" : "") <button type="button" @onclick="Cancel">Cancel operation</button></div> }
    <section class="gump-panel">
        <div class="gump-panel-heading"><div><h2>Current archive</h2><p class="muted">@(Workspace.Gumps is null ? "Open Gumps from the configured folder." : $"{Workspace.DisplayName} · {Workspace.Gumps.Format} · {Workspace.Gumps.Entries.Count:N0} ID · {Workspace.Gumps.DirtyCount} draft changes")</p></div>
            <FluentButton OnClick="OpenPrimary" Disabled="@(Busy || Workspace.Gumps?.HasChanges == true)">Open configured folder</FluentButton></div>
        @if (Workspace.Gumps?.HasChanges == true) { <p class="muted">Drafts are also visible in the viewer. Save a version to keep them beyond this session.</p> }
        @if (Workspace.Gumps is not null)
        {
            <p class="muted">Shared revision @Workspace.SharedRevision · @Session.User?.Name</p>
            <FluentButton OnClick="RefreshShared" Disabled="Busy">Refresh shared version</FluentButton>
        }
    </section>
    @if (Workspace.Gumps is not null)
    {
        <section class="gump-panel">
            <h2>1 · Add or replace a Gump</h2>
            <div class="gump-target"><label for="gump-target-id">Target ID</label><input id="gump-target-id" @bind="Target" @bind:after="ShowSelection" disabled="@Busy" placeholder="1234 or 0x04D2" />
                <span class="muted">@(TargetExists ? "Existing ID: will be replaced in the draft." : "Unused ID: will be added to the draft.")</span></div>
            <div class="edit-lease-panel" aria-live="polite">
                @if (TargetLease is { } lease)
                { <p>@(lease.SessionId == Session.SessionId ? "You are editing this ID." : $"This ID is being edited by {lease.UserName}.") @(lease.Saving ? "Publishing in progress." : "")</p> }
                else { <p>This ID is available. Start editing to reserve it before importing or replacing an image.</p> }
                <p class="muted">Other users can still view and compare this ID. Drafts stay private until published.</p>
                <div class="edit-lease-actions">
                    <FluentButton OnClick="StartEditing" Disabled="@(Busy || OwnsTarget)">Start editing ID</FluentButton>
                    <FluentButton OnClick="ReleaseTarget" Disabled="@(Busy || !OwnsTarget || TargetModified)">Release ID</FluentButton>
                </div>
            </div>
            <label class="gump-upload-label" for="gump-png">PNG from your PC (maximum 8 MiB)</label>
            <InputFile id="gump-png" @key="UploadVersion" OnChange="LoadPng" accept=".png,image/png" disabled="@Busy" />
            <p class="muted">The preview shows the converted result: 15-bit RGB; alpha below 128 is transparent. Opaque black becomes near-black to preserve opacity.</p>
            @if (Pending is not null)
            {
                <div class="gump-pending"><div class="gump-image checker"><img src="@PendingImage" alt="PNG converted to Gump format" /></div><div><strong>@PendingName</strong><p class="muted">@Pending.Width × @Pending.Height px · conversion ready</p>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="InsertPng" Disabled="@(Busy || !OwnsTarget)">@(TargetExists ? "Replace in draft" : "Add to draft")</FluentButton>
                    <FluentButton OnClick="ClearPending" Disabled="Busy">Close PNG preview</FluentButton></div></div>
            }
            <div class="gump-draft-actions"><FluentButton OnClick="UndoTarget" Disabled="@(Busy || !TargetModified)">Undo changes to this ID</FluentButton>
                <FluentButton OnClick="DiscardAll" Disabled="@(Busy || !Workspace.Gumps.HasChanges)">Discard all drafts</FluentButton></div>
        </section>
        <section class="gump-panel">
            <h2>2 · Compare another archive</h2>
            <label for="gump-reference">MUL or UOP file, or folder on the server</label>
            <input id="gump-reference" class="full-width" @bind="ReferencePath" disabled="@Busy" placeholder="D:\Reference\gumpartLegacyMUL.uop" />
            <label for="gump-reference-index">MUL index (optional: gumpidx.mul in the same folder)</label>
            <div class="gump-path-row"><input id="gump-reference-index" @bind="ReferenceIndex" disabled="@Busy" placeholder="D:\Reference\gumpidx.mul" />
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Compare" Disabled="Busy">Compare</FluentButton></div>
            @if (ReferenceName is not null) { <p class="muted">Open reference: @ReferenceName</p> }
            @if (Rows.Count > 0)
            {
                <div class="gump-comparison-summary">
                    @foreach (var status in Enum.GetValues<Fiddler.Formats.Gumps.GumpDifference>()) { <span><strong>@Rows.Count(row => row.Difference == status)</strong> @DifferenceLabel(status)</span> }
                </div>
                <label class="gump-filter"><input type="checkbox" @bind="OnlyDifferences" @bind:after="ResetPage" /> Show only differences and issues</label>
                <div class="file-table-container"><table class="file-table"><thead><tr><th>ID</th><th>Comparison</th><th>Details</th><th>Preview</th></tr></thead><tbody>
                    @foreach (var row in PageRows)
                    {
                        <tr><td>@($"0x{row.Id:X4}") (@row.Id)</td><td>@DifferenceLabel(row.Difference)</td><td>@row.Detail</td><td><button type="button" disabled="@Busy" @onclick="() => SelectComparison(row.Id)">Show</button></td></tr>
                    }
                </tbody></table></div>
                <div class="pagination"><FluentButton OnClick="PreviousPage" Disabled="@(Busy || Page == 0)">Previous</FluentButton><span>Page @(Page + 1) of @PageCount</span><FluentButton OnClick="NextPage" Disabled="@(Busy || Page + 1 >= PageCount)">Next</FluentButton></div>
            }
            <div class="gump-side-by-side">
                <div><h3>Current · ID @Target</h3><div class="gump-image checker">
                    @if (CurrentImage is not null) { <img src="@CurrentImage" alt="Current Gump, including drafts" /> } else { <p class="muted">@(CurrentDetail ?? "ID not found.")</p> }
                </div></div>
                <div><h3>Reference @(SelectedReference is int refId ? $"· ID 0x{refId:X4}" : "")</h3><div class="gump-image checker">
                    @if (ReferenceImage is not null) { <img src="@ReferenceImage" alt="Gump in the reference archive" /> } else { <p class="muted">@(ReferenceDetail ?? "Select a comparison row.")</p> }
                </div></div>
            </div>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="CopyReference" Disabled="@(Busy || ReferenceImage is null || !OwnsTarget)">Copy reference to target ID</FluentButton>
        </section>
        <section class="gump-panel">
            <h2>3 · Save a complete version</h2>
            <p class="muted">Merges your drafts with the latest published shared version and writes a complete new MUL/IDX pair. Other users' published IDs are preserved. Original archives remain unchanged.</p>
            <label for="gump-output">Output folder on the server</label>
            <div class="gump-path-row"><input id="gump-output" @bind="OutputParent" disabled="@Busy" /><FluentButton Appearance="ButtonAppearance.Primary" OnClick="Export" Disabled="@(Busy || !Workspace.Gumps.HasChanges)">Publish new MUL/IDX version</FluentButton></div>
            @if (ExportedDirectory is not null)
            {
                <p class="muted">Saved version: <strong class="saved-directory">@ExportedDirectory</strong></p>
                <FluentButton OnClick="OpenExport" Disabled="Busy">Refresh to latest shared version</FluentButton>
            }
        </section>
    }
</section>
