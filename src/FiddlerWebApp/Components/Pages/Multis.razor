@page "/multi"
@using Fiddler.Formats.Multis
@using Fiddler.Graphics.World
@using FiddlerWebApp.Components.World
@inject WorldAssetWorkspace Workspace
@inject ClientDirectorySettings Settings

<PageTitle>Multi · Fiddler</PageTitle>
<section class="world-page">
    <div class="section-label">CLIENT LIBRARY / MULTI</div><h1>Multi</h1>
    <p>Load houses, ships and composite structures. Components reference Art items, rather than Gumps.</p>
    <div class="world-controls">
        <label>Archive<select @bind="source"><option value="auto">Automatic (UOP if available)</option><option value="mul">multi.mul + multi.idx</option><option value="uop">MultiCollection.uop</option></select></label>
        <label>MUL format<select @bind="rowSize"><option value="16">High Seas · 16 bytes</option><option value="12">Legacy · 12 bytes</option></select></label>
        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Open" Disabled="busy">Load Multis</FluentButton>
        <a href="/configuration">Configure server folder</a>
    </div>
    <p class="muted">Choose the MUL format for your client version: record lengths can fit both formats, so detection can be ambiguous. UOP describes its own format.</p>
    @if (error is not null) { <div class="notice error" role="alert">@error</div> }
    @if (loaded && Workspace.Multis is { } archive)
    {
        <p>@archive.Ids.Count Multi · @archive.Format · @Workspace.Directory</p>
        <div class="world-controls">
            <label>Multi ID<input @bind="idInput" placeholder="44 or 0x002C" /></label>
            <FluentButton OnClick="Load" Disabled="busy">View ID</FluentButton>
            <FluentButton OnClick="Previous" Disabled="@(busy || currentIndex <= 0)">Previous Multi</FluentButton>
            <FluentButton OnClick="Next" Disabled="@(busy || currentIndex < 0 || currentIndex + 1 >= archive.Ids.Count)">Next Multi</FluentButton>
            <label>Maximum Z<input type="number" @bind="maxZ" /></label>
            <label class="world-checkbox"><input type="checkbox" @bind="includeInvisible" /> Include flags 0</label>
            <FluentButton OnClick="Filter">Apply filters</FluentButton>
        </div>
        <p class="world-current">Multi @currentId (@($"0x{currentId:X4}")) · @components.Count total components · @tiles.Count visible</p>
        <AssetScenePreview Tiles="tiles" />
    }
</section>

@code {
    private string source = "auto", idInput = "0";
    private int rowSize = 16, maxZ = 32767, currentIndex = -1, currentId;
    private bool busy, loaded, includeInvisible;
    private string? error;
    private IReadOnlyList<MultiComponent> components = [];
    private IReadOnlyList<WorldTile> tiles = [];
    private async Task Open()
    {
        busy = true; error = null; await Task.Yield();
        try
        {
            Workspace.OpenMultis(Settings.Directory, source == "auto" ? null : source == "uop", rowSize);
            loaded = true; components = []; tiles = []; currentIndex = -1;
            if (Workspace.Multis!.Ids.Count == 0) throw new InvalidDataException("No Multis found in the index.");
            idInput = Workspace.Multis.Ids[0].ToString(); Load();
        }
        catch (Exception ex) when (Expected(ex)) { error = ex.Message; }
        finally { busy = false; }
    }
    private static bool Expected(Exception ex) => ex is IOException or InvalidDataException or ArgumentException or InvalidOperationException or KeyNotFoundException or UnauthorizedAccessException;
    private void Load()
    {
        error = null;
        try
        {
            string text = idInput.Trim();
            bool valid = text.StartsWith("0x", StringComparison.OrdinalIgnoreCase)
                ? int.TryParse(text[2..], System.Globalization.NumberStyles.AllowHexSpecifier, null, out int id) : int.TryParse(text, out id);
            if (!valid || id < 0) throw new ArgumentException("Enter a valid Multi ID in decimal or hexadecimal.");
            var archive = Workspace.Multis ?? throw new InvalidOperationException("Load the Multi archive.");
            var next = archive.Read(id);
            components = next; currentId = id; currentIndex = archive.Ids.ToList().IndexOf(id); Filter();
        }
        catch (Exception ex) when (Expected(ex)) { error = ex.Message; }
    }
    private void Filter() => tiles = components.Where(c => c.Z <= maxZ && (includeInvisible || c.Flags != 0))
        .Select(c => new WorldTile(c.Index, c.ItemId, c.X, c.Y, c.Z, false, Flags: c.Flags)).ToArray();
    private void Previous() { if (currentIndex > 0) { idInput = Workspace.Multis!.Ids[currentIndex - 1].ToString(); Load(); } }
    private void Next() { if (Workspace.Multis is { } archive && currentIndex + 1 < archive.Ids.Count) { idInput = archive.Ids[currentIndex + 1].ToString(); Load(); } }
}
