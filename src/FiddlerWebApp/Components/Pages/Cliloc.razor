@page "/cliloc"
@inherits ResourceEditorPage
@using Fiddler.Formats.Localization

<PageTitle>Cliloc · @ApplicationInfo.Name</PageTitle>
<section class="resource-editor">
    <div class="section-label">@ApplicationInfo.ShortName / LOCALIZATION</div><h1>Cliloc</h1>
    <p>Find, add, edit and remove localized strings. Drafts belong to this session; exports preserve the original files.</p>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (exported is not null) { <p class="notice success" role="status">Exported: @exported</p> }
    <div class="resource-toolbar">
        <label>Client file<select @bind="file" disabled="@busy">@foreach (string name in files) { <option>@name</option> }</select></label>
        <button @onclick="Open" disabled="@(busy || files.Length == 0)">Open Cliloc</button>
        <a href="/configuration">Configure folder</a>
    </div>
    @if (files.Length == 0) { <p>No cliloc.* files found in the configured folder.</p> }
    @if (Resources.Cliloc is { } document)
    {
        <p>@Resources.ClilocDirectory / @document.FileName · @filtered.Length strings · @document.DirtyCount draft changes @(document.WasCompressed ? "· compressed source; exports use plain Cliloc format" : "")</p>
        <div class="resource-toolbar"><label>Find ID or text<input @bind="query" @bind:after="Filter" /></label><button @onclick="() => Run(() => { document.Discard(); Filter(); })" disabled="@busy">Discard all drafts</button></div>
        <div class="resource-columns">
            <div>
                <div class="file-table-container"><table class="file-table"><thead><tr><th>ID</th><th>Flag</th><th>Text</th><th></th></tr></thead><tbody>
                    @foreach (var entry in filtered.Skip(page * 48).Take(48))
                    { <tr class="@(entry.Id == selected ? "resource-selected" : "")"><td>@entry.Id</td><td>@entry.Flag</td><td class="resource-string">@entry.Text</td><td><button @onclick="() => Select(entry)">Edit</button></td></tr> }
                </tbody></table></div>
                <div class="resource-toolbar"><button disabled="@(page == 0)" @onclick="() => page--">Previous</button><span>@(page + 1) / @PageCount</span><button disabled="@(page + 1 >= PageCount)" @onclick="() => page++">Next</button></div>
            </div>
            <div class="resource-panel">
                <h2>String editor</h2>
                <label>ID<input @bind="entryId" /></label><label>Flag<input type="number" min="0" max="255" @bind="flag" /></label>
                <label>UTF-8 text<textarea rows="10" @bind="text"></textarea></label>
                <p class="muted">Preserve placeholders such as ~1_NAME~ when they are used by the client. Maximum 65,535 UTF-8 bytes.</p>
                <div class="resource-toolbar"><button @onclick="Save" disabled="@busy">Add / replace draft</button>
                    <button @onclick="Remove" disabled="@(busy || selected is null)">Remove selected ID</button>
                    <button @onclick="Undo" disabled="@busy">Undo ID</button></div>
            </div>
        </div>
        <div class="resource-toolbar"><label>Output parent folder on server<input @bind="output" placeholder="Absolute path" /></label><button @onclick="Export" disabled="@busy">Export new Cliloc file</button></div>
    }
</section>
@code {
    private string[] files = [];
    private string file = "", query = "", entryId = "", text = "";
    private byte flag;
    private int? selected;
    private int page;
    private ClilocEntry[] filtered = [];
    private int PageCount => Math.Max(1, (filtered.Length + 47) / 48);
    protected override void OnInitialized()
    { files = ClientResourceWorkspace.Files(Settings.Directory, "cliloc.*"); file = files.FirstOrDefault() ?? ""; Filter(); }
    private Task Open() => Run(() => { Resources.OpenCliloc(Settings.Directory, file); selected = null; Filter(); });
    private void Filter()
    {
        string search = query.Trim();
        filtered = Resources.Cliloc?.Entries.Where(e => search.Length == 0 || e.Id.ToString() == search || e.Text.Contains(search, StringComparison.OrdinalIgnoreCase)).ToArray() ?? [];
        page = 0;
    }
    private void Select(ClilocEntry entry) { selected = entry.Id; entryId = entry.Id.ToString(); flag = entry.Flag; text = entry.Text; }
    private Task Save() => Run(() => { var entry = new ClilocEntry(Id(entryId), flag, text); Resources.Cliloc!.Put(entry); Filter(); Select(entry); });
    private Task Remove() => Run(() => { if (selected is int id) Resources.Cliloc!.Remove(id); selected = null; Filter(); });
    private Task Undo() => Run(() => { int id = Id(entryId); Resources.Cliloc!.Undo(id); Filter(); var original = Resources.Cliloc.Entries.FirstOrDefault(e => e.Id == id); if (original is not null) Select(original); else selected = null; });
    private Task Export() => RunAsync(async () => exported = await Task.Run(() => Resources.Cliloc!.Export(output)));
}
