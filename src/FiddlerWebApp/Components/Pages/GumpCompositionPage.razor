@page "/gump/composizione"
@using Fiddler.Graphics.Gumps
@using Fiddler.Formats.Gumps
@inject GumpComposition Composition
@inject GumpCompositionRenderer Renderer
@inject MulWorkspace Workspace
@inject ClientDirectorySettings Settings

<PageTitle>Composizione Gump · Fiddler</PageTitle>
<div class="composition-page">
    <div class="section-label">GUMP / COMPOSIZIONE</div>
    <h1>Componi sulla griglia</h1>
    <p>I pezzi mantengono le dimensioni originali. Ogni origine si aggancia alla griglia; un'immagine può occupare più celle.</p>
    <p class="muted">La composizione è una bozza della sessione: non modifica i MUL e non ricostruisce automaticamente i layout del gioco. Ricaricando la pagina può andare persa.</p>
    @if (error is not null) { <div class="notice error" role="alert">@error</div> }
    <div class="composition-layout">
        <aside class="composition-controls">
            <h2>Griglia</h2>
            <label>Larghezza piano (px)<input type="number" min="64" max="2048" @bind="width" /></label>
            <label>Altezza piano (px)<input type="number" min="64" max="2048" @bind="height" /></label>
            <label>Lato cella (px)<input type="number" min="4" max="256" @bind="cell" /></label>
            <FluentButton OnClick="Configure">Applica e allinea</FluentButton>
            <label class="composition-check"><input type="checkbox" @bind="showGrid" @bind:after="Refresh" /> Mostra griglia</label>
            <label>Zoom<select @bind="zoom"><option value="0.5">50%</option><option value="1">100%</option><option value="2">200%</option></select></label>
            <h2>Aggiungi un pezzo</h2>
            <label>ID Gump (decimale o 0x…)<input @bind="idInput" placeholder="44 oppure 0x002C" /></label>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="Add">Aggiungi alla griglia</FluentButton>
            <p class="muted">Dalla cartella configurata; viene scelto il primo spazio libero. Puoi aggiungere più copie dello stesso ID.</p>
            <FluentButton OnClick="Arrange" Disabled="@(Composition.Pieces.Count == 0)">Disponi senza sovrapposizioni</FluentButton>
            <h2>Pezzo selezionato</h2>
            @if (Selected is { } piece)
            {
                <p><strong>ID @piece.GumpId · @($"0x{piece.GumpId:X4}")</strong><br />@piece.Image.Width × @piece.Image.Height px · posizione @piece.X, @piece.Y</p>
                <label>X (px)<input type="number" @bind="positionX" /></label>
                <label>Y (px)<input type="number" @bind="positionY" /></label>
                <FluentButton OnClick="Move">Aggancia posizione</FluentButton>
                <label class="composition-check"><input type="checkbox" @bind="placeOnClick" /> Sposta qui con un clic sul piano</label>
                <FluentButton OnClick="Remove">Rimuovi pezzo</FluentButton>
                <a href="@($"/gump/gestione?id={piece.GumpId}")">Importa o confronta l'immagine originale</a>
                <FluentButton OnClick="Reload">Aggiorna immagine dal workspace</FluentButton>
            }
            else { <p class="muted">Clicca un'immagine sul piano oppure selezionala nell'elenco.</p> }
            <a href="/gump">Torna al catalogo Gump</a>
        </aside>
        <section class="composition-main" aria-label="Composizione Gump">
            <p aria-live="polite">@Composition.Pieces.Count pezzi · piano @Composition.Width × @Composition.Height px · celle @Composition.CellSize px</p>
            <div class="composition-viewport">
                @if (preview is not null)
                {
                    <img class="composition-board" src="@preview" alt="Piano Gump: clicca un pezzo per selezionarlo" draggable="false"
                         style="width:@(Pixels(Composition.Width * zoom))px;height:@(Pixels(Composition.Height * zoom))px"
                         @onclick="BoardClick" />
                }
            </div>
            <p class="muted">@(placeOnClick && Selected is not null ? "Clicca per posizionare l'angolo superiore sinistro del pezzo sulla griglia." : "Clicca un pezzo per selezionarlo. In caso di sovrapposizione viene selezionato quello sopra.")</p>
            <div class="composition-pieces" aria-label="Pezzi della composizione">
                @foreach (var item in Composition.Pieces)
                {
                    <button class="@(item.Key == selectedKey ? "active" : "")" @onclick="() => Select(item.Key)" aria-pressed="@(item.Key == selectedKey)">
                        #@item.Key · ID @item.GumpId (@($"0x{item.GumpId:X4}")) · X @item.X / Y @item.Y
                    </button>
                }
            </div>
        </section>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "id")] public string? RequestedId { get; set; }
    private int width, height, cell, positionX, positionY;
    private int? selectedKey;
    private double zoom = 1;
    private bool showGrid = true, placeOnClick;
    private string idInput = "", lastRequested = "";
    private string? preview, error;
    private GumpPiece? Selected => Composition.Pieces.FirstOrDefault(p => p.Key == selectedKey);
    private static string Pixels(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    protected override void OnInitialized()
    {
        width = Composition.Width; height = Composition.Height; cell = Composition.CellSize;
        Refresh();
    }
    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(RequestedId) && RequestedId != lastRequested)
        { idInput = RequestedId; lastRequested = RequestedId; }
    }
    private void Run(Action action)
    {
        error = null;
        try { action(); Refresh(); }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException or InvalidOperationException or KeyNotFoundException or UnauthorizedAccessException)
        { error = ex.Message; }
    }
    private void Refresh() => preview = "data:image/png;base64," + Convert.ToBase64String(Renderer.RenderPng(Composition, selectedKey, showGrid));
    private void Configure() => Run(() => { Composition.Configure(width, height, cell); SyncPosition(); });
    private void Arrange() => Run(() => { Composition.AutoArrange(); SyncPosition(); });
    private void Add() => Run(() =>
    {
        string value = idInput.Trim();
        bool valid = value.StartsWith("0x", StringComparison.OrdinalIgnoreCase)
            ? int.TryParse(value[2..], System.Globalization.NumberStyles.AllowHexSpecifier, null, out int id)
            : int.TryParse(value, out id);
        if (!valid || id < 0 || id >= GumpUopReader.MaxSlots) throw new ArgumentException("Inserisci un ID Gump valido, decimale o esadecimale.");
        if (Workspace.Gumps is null) Workspace.Open(Settings.Directory);
        var document = Workspace.Gumps ?? throw new InvalidOperationException("La cartella non contiene un archivio Gump.");
        selectedKey = Composition.Add(id, document.Read(id)).Key;
        SyncPosition(); placeOnClick = false;
    });
    private void Select(int key) { selectedKey = key; placeOnClick = false; SyncPosition(); Refresh(); }
    private void SyncPosition() { if (Selected is { } piece) { positionX = piece.X; positionY = piece.Y; } }
    private void Move() => Run(() => { if (selectedKey is int key) Composition.Move(key, positionX, positionY); SyncPosition(); });
    private void Remove() => Run(() => { if (selectedKey is int key) Composition.Remove(key); selectedKey = null; placeOnClick = false; });
    private void Reload() => Run(() =>
    {
        if (Selected is not { } piece) return;
        var image = Workspace.Gumps?.Read(piece.GumpId) ?? throw new InvalidOperationException("Apri l'archivio nel workspace.");
        Composition.ReplaceImage(piece.Key, image);
        SyncPosition();
    });
    private void BoardClick(MouseEventArgs args) => Run(() =>
    {
        double x = args.OffsetX / zoom, y = args.OffsetY / zoom;
        if (placeOnClick && selectedKey is int key) { Composition.Move(key, x, y); SyncPosition(); }
        else { selectedKey = Composition.HitTest(x, y)?.Key; SyncPosition(); }
    });
}
