@page "/art/manage"
@inherits ResourceEditorPage
@using Fiddler.Graphics.Gumps
@inject MulWorkspace Workspace

<PageTitle>Edit Item and Land art · Fiddler</PageTitle>
<section class="resource-editor">
    <div class="section-label">FIDDLER / GRAPHICS</div><h1>Edit Item and Land art</h1>
    <p>Import a PNG to add or replace an ID. Images are converted to the client format immediately, so the preview shows the exported colors.</p>
    @if (error is not null) { <p class="notice error" role="alert">@error</p> }
    @if (exported is not null) { <p class="notice success" role="status">Exported Art pair: @exported</p> }
    <div class="resource-toolbar"><button @onclick="Open" disabled="@busy">Open configured archive</button><a href="/gump">Browse graphics</a><a href="/gump/manage">Edit Gumps</a><a href="/fonts">Edit font glyphs</a></div>
    @if (Workspace.Art is { } art)
    {
        <p>@Workspace.CurrentDirectory · @art.DirtyCount Art drafts</p>
        <div class="resource-toolbar">
            <label>Collection<select @bind="kind" @bind:after="ChangeKind"><option value="@AssetKind.Item">Items</option><option value="@AssetKind.Land">Land</option></select></label>
            <label>ID<input @bind="assetId" placeholder="Decimal or 0x…" /></label><button @onclick="Preview">Show ID</button>
            <label>Zoom<select @bind="zoom"><option value="1">100%</option><option value="2">200%</option><option value="4">400%</option></select></label>
        </div>
        <div class="resource-columns">
            <div>
                <div class="resource-grid">
                    @foreach (var entry in entries.Skip(page * 48).Take(48))
                    { <button @onclick="() => Show(entry.Id)"><strong>@entry.Id</strong><span>@($"0x{entry.Id:X4}") @(art.IsModified(kind, entry.Id) ? "*" : "")</span></button> }
                </div>
                <div class="resource-toolbar"><button disabled="@(page == 0)" @onclick="() => page--">Previous</button><span>@(page + 1) / @PageCount</span><button disabled="@(page + 1 >= PageCount)" @onclick="() => page++">Next</button></div>
            </div>
            <div class="resource-panel">
                <h2>@kind @assetId</h2>
                @if (preview is not null)
                { <div class="resource-preview checker"><img src="@preview" alt="Converted client art" style="width:@(width * zoom)px;height:@(height * zoom)px" /></div><a href="@preview" download="@($"{kind}-{assetId}.png")">Download PNG</a> }
                else { <p>This ID has no preview. Import a PNG to create it.</p> }
                <label>Add / replace from PNG<InputFile OnChange="Import" accept="image/png" disabled="@busy" /></label>
                <p class="muted">8 MiB maximum. Items use RGB555 and one-bit transparency (alpha ≥ 128). Land is a 44 × 44 opaque diamond: corners are not stored.</p>
                <div class="resource-toolbar"><button @onclick="Remove" disabled="@busy">Remove ID</button><button @onclick="Undo" disabled="@busy">Undo ID</button>
                    <button @onclick="() => Run(() => { art.Discard(); Refresh(); LoadPreview(); })" disabled="@busy">Discard all Art drafts</button></div>
            </div>
        </div>
        <div class="resource-toolbar"><label>Output parent folder on server<input @bind="output" placeholder="Absolute path" /></label><button @onclick="Export" disabled="@busy">Export new art.mul / artidx.mul</button></div>
        <p class="muted">Art drafts are visible in this session's catalog, Color studio and plugin commands. Export writes the complete pair to a new folder. These exports are private copies; Gump shared publishing remains separate.</p>
    }
    else { <p>Requires art.mul + artidx.mul. Configure the folder before opening.</p> }
</section>
@code {
    [SupplyParameterFromQuery(Name = "kind")] public string? RequestedKind { get; set; }
    [SupplyParameterFromQuery(Name = "id")] public string? RequestedId { get; set; }
    private AssetKind kind = AssetKind.Item;
    private string assetId = "0";
    private string? preview, lastRequest;
    private int width, height, page, zoom = 1;
    private IReadOnlyList<MulEntry> entries = [];
    private int PageCount => Math.Max(1, (entries.Count + 47) / 48);
    protected override void OnParametersSet()
    {
        string request = RequestedKind + ":" + RequestedId;
        if (request != lastRequest)
        {
            lastRequest = request;
            if (Enum.TryParse<AssetKind>(RequestedKind, true, out var next) && next is AssetKind.Item or AssetKind.Land) kind = next;
            if (RequestedId is not null) assetId = RequestedId;
            Refresh();
            if (Workspace.Art is not null) _ = Preview();
        }
    }
    private Task Open() => Run(() => { if (!Workspace.IsOpen || !string.Equals(Workspace.CurrentDirectory, Settings.Directory, StringComparison.OrdinalIgnoreCase)) Workspace.Open(Settings.Directory); Refresh(); LoadPreview(); });
    private void Refresh() => entries = Workspace.Art?.Entries(kind) ?? [];
    private void ChangeKind() { page = 0; preview = null; Refresh(); }
    private Task Show(int id) { assetId = id.ToString(); return Preview(); }
    private Task Preview() => Run(LoadPreview);
    private void LoadPreview()
    {
        preview = null;
        int id = Id(assetId);
        if (Workspace.Art is null || !Workspace.Art.Entries(kind).Any(e => e.Id == id)) return;
        var image = Workspace.Art.Read(kind, id); width = image.Width; height = image.Height; preview = Png(image);
    }
    private Task Import(InputFileChangeEventArgs args) => RunAsync(async () =>
    { var image = GumpImageImporter.ImportImage(await Upload(args.File)); Workspace.Art!.Put(kind, Id(assetId), image); Refresh(); LoadPreview(); });
    private Task Remove() => Run(() => { Workspace.Art!.Remove(kind, Id(assetId)); Refresh(); page = Math.Min(page, PageCount - 1); LoadPreview(); });
    private Task Undo() => Run(() => { Workspace.Art!.Undo(kind, Id(assetId)); Refresh(); LoadPreview(); });
    private Task Export() => RunAsync(async () => exported = await Task.Run(() => Workspace.Art!.Export(output)));
}
