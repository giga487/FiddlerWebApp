@page "/users"
@using FiddlerWebApp.Services.Users
@implements IAsyncDisposable
@inject UserSession Session
@inject UserDirectory Directory
@inject ResourceLeaseManager Leases
@inject ClientDirectorySettings Settings

<PageTitle>Users · Fiddler</PageTitle>
<section class="user-page">
    <div class="section-label">USER CONTEXT</div><h1>Your workspace</h1>
    <div class="user-profile"><h2>@Session.User!.Name</h2><p>@Session.User.Provider · @(Session.User.Email ?? "No email stored")</p>
        <p><strong>Your data folder:</strong> @(string.IsNullOrEmpty(Settings.Directory) ? "Not configured" : Settings.Directory)</p>
        <a href="/configuration">Configure your files</a> · <a href="/gump/manage">Manage Gumps</a></div>
    <p>File settings belong to your account. Drafts and temporary compositions belong to this browser session. Published Gump versions are shared with people using the same source archive.</p>
    <h2>Active users</h2>
    <div class="file-table-container"><table class="file-table"><thead><tr><th>User</th><th>Provider</th><th>Sessions</th></tr></thead><tbody>
        @foreach (var group in Directory.Active().GroupBy(u => u.User.Id))
        { <tr><td>@group.First().User.Name @(group.Key == Session.User.Id ? "(you)" : "")</td><td>@group.First().User.Provider</td><td>@group.Count()</td></tr> }
    </tbody></table></div>
    <h2>IDs being edited</h2>
    <p class="muted">Edit leases last two minutes and are renewed by connected sessions. Viewing remains available. The same account in another tab is a separate editing session.</p>
    <div class="file-table-container"><table class="file-table"><thead><tr><th>Archive</th><th>Resource</th><th>ID</th><th>User</th><th>Status</th></tr></thead><tbody>
        @foreach (var lease in Leases.List())
        { <tr><td title="@lease.Asset.Archive">@System.IO.Path.GetFileName(lease.Asset.Archive)</td><td>@lease.Asset.Kind</td><td>@lease.Asset.Id (@($"0x{lease.Asset.Id:X4}"))</td><td>@lease.UserName @(lease.SessionId == Session.SessionId ? "(this session)" : "")</td><td>@(lease.Saving ? "Publishing" : "Editing")</td></tr> }
    </tbody></table></div>
    <p class="muted">Live lists refresh every five seconds. Multi, map and animation viewers are read-only and do not acquire edit leases.</p>
</section>

@code {
    private readonly CancellationTokenSource lifetime = new();
    private Task? updates;
    protected override void OnAfterRender(bool firstRender) { if (firstRender) updates = Update(); }
    private async Task Update()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try { while (await timer.WaitForNextTickAsync(lifetime.Token)) await InvokeAsync(StateHasChanged); }
        catch (OperationCanceledException) when (lifetime.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync() { lifetime.Cancel(); if (updates is not null) await updates; lifetime.Dispose(); }
}
