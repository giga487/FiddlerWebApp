@using Fiddler.Graphics.World
@inject IsometricSceneRenderer Renderer
@inject WorldAssetWorkspace Workspace

@if (error is not null) { <div class="notice error" role="alert">@error</div> }
@if (scene is not null)
{
    <div class="world-preview-toolbar"><label>Zoom <select @bind="zoom"><option value="0.5">50%</option><option value="1">100%</option><option value="2">200%</option></select></label>
        <span>@Tiles.Count pieces · @Workspace.ArtFormat</span></div>
    <div class="world-preview-scroll"><img src="@image" alt="Isometric preview: click a tile to select it" draggable="false"
        style="width:@(Px(scene.Width * zoom))px;height:@(Px(scene.Height * zoom))px" @onclick="Click" /></div>
    @if (scene.Warnings.Count > 0)
    {
        <details class="world-warnings"><summary>Missing or invalid Art: shown as magenta placeholders</summary>
            <ul>@foreach (var warning in scene.Warnings) { <li>@warning</li> }</ul></details>
    }
}
@if (Selected is { } tile)
{
    <div class="world-inspector" aria-live="polite"><strong>@(tile.Land ? "Land" : "Item") ID @tile.Id · @($"0x{tile.Id:X4}")</strong>
        <span>X @tile.X / Y @tile.Y / Z @tile.Z</span><span>Hue @tile.Hue · Flags @tile.Flags</span></div>
}
<p class="muted">Select a piece in the preview or list. Isometric asset preview: hue and slope deformation are not applied; tiledata, animations and diff patches are not interpreted.</p>
<div class="world-table-scroll"><table class="file-table"><thead><tr><th>Piece</th><th>Type</th><th>Decimal ID / hex</th><th>X</th><th>Y</th><th>Z</th><th>Hue</th><th>Flags</th></tr></thead><tbody>
    @foreach (var row in Tiles.Skip(page * 64).Take(64))
    {
        <tr class="@(selectedKey == row.Key ? "world-selected" : "")"><td><button @onclick="() => Select(row.Key)">#@row.Key</button></td>
            <td>@(row.Land ? "Land" : "Item")</td><td>@row.Id / @($"0x{row.Id:X4}")</td><td>@row.X</td><td>@row.Y</td><td>@row.Z</td><td>@row.Hue</td><td>@row.Flags</td></tr>
    }
</tbody></table></div>
<div class="world-pagination"><FluentButton OnClick="() => page--" Disabled="@(page == 0)">Previous</FluentButton>
    <span>Page @(page + 1) of @Math.Max(1, (Tiles.Count + 63) / 64)</span>
    <FluentButton OnClick="() => page++" Disabled="@((page + 1) * 64 >= Tiles.Count)">Next</FluentButton></div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<WorldTile> Tiles { get; set; } = [];
    private IReadOnlyList<WorldTile>? previous;
    private ScenePreview? scene;
    private string? image, error;
    private int? selectedKey;
    private int page;
    private double zoom = 1;
    private WorldTile? Selected => Tiles.FirstOrDefault(t => t.Key == selectedKey);
    private static string Px(double value) => value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(previous, Tiles)) { previous = Tiles; page = 0; selectedKey = null; Refresh(); }
    }
    private void Refresh()
    {
        error = null; scene = null; image = null;
        try { scene = Renderer.Render(Tiles, Workspace.ReadArt, selectedKey); image = "data:image/png;base64," + Convert.ToBase64String(scene.Png); }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException or InvalidOperationException) { error = ex.Message; }
    }
    private void Select(int key) { selectedKey = key; Refresh(); }
    private void Click(MouseEventArgs args)
    {
        selectedKey = scene?.HitTest(args.OffsetX / zoom, args.OffsetY / zoom)?.Key;
        int index = selectedKey is int key ? Tiles.ToList().FindIndex(t => t.Key == key) : -1;
        if (index >= 0) page = index / 64;
        Refresh();
    }
}
