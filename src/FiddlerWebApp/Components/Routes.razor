@using Microsoft.AspNetCore.Components.Authorization
@using FiddlerWebApp.Services.Users
@using FiddlerWebApp.Components.Pages
@inject AuthenticationStateProvider Authentication
@inject UserSession Session
@implements IDisposable

@if (!ready)
{
    <p role="status">Loading user context…</p>
}
else if (!Session.IsSignedIn)
{
    <LayoutView Layout="typeof(Layout.MainLayout)"><SignInPanel /></LayoutView>
}
else
{
<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
}

@code {
    private bool ready;
    private bool disposed;
    protected override async Task OnInitializedAsync()
    {
        Session.Initialize((await Authentication.GetAuthenticationStateAsync()).User);
        Session.IdentityChanged += IdentityChanged;
        ready = true;
    }
    private void IdentityChanged() { if (!disposed) _ = InvokeAsync(StateHasChanged); }
    public void Dispose() { disposed = true; Session.IdentityChanged -= IdentityChanged; }
}
